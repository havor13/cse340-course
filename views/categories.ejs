<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>
  <section class="card-grid">
    <% categories.forEach(cat => { %>
      <div class="card">
        <h2><%= cat.name %></h2>
        <p><%= cat.description %></p>
      </div>
    <% }) %>
  </section>
</main>

<%- include('partials/footer') %>
