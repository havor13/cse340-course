<%- include('partials/header') %>

<main>
  <h1>Categories</h1>

  <!-- Flash messages -->
  <% if (messages && messages.success) { %>
    <p class="flash-success"><%= messages.success %></p>
  <% } %>
  <% if (messages && messages.error) { %>
    <p class="flash-error"><%= messages.error %></p>
  <% } %>

  <!-- Link to create new category -->
  <p>
    <a href="/new-category" class="btn">+ Add New Category</a>
  </p>

  <section class="card-grid">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(category => { %>
        <div class="card">
          <h2>
            <a href="/category/<%= category.category_id %>">
              <%= category.name %>
            </a>
          </h2>

          <% if (category.image_url) { %>
            <div class="thumbnail">
              <img src="<%= category.image_url %>" alt="Category image" style="max-width:150px;">
            </div>
          <% } %>

          <% if (category.description) { %>
            <p><%= category.description %></p>
          <% } %>

          <!-- Edit link -->
          <p>
            <a href="/edit-category/<%= category.category_id %>" class="btn-small">
              Edit
            </a>
          </p>
        </div>
      <% }) %>
    <% } else { %>
      <p>No categories found.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
