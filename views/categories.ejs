<%- include('partials/header') %>

<main>
  <h1>Categories</h1>

  <!-- Flash messages -->
  <% if (messages.success && messages.success.length > 0) { %>
    <div class="flash flash-success" aria-live="polite">
      <% messages.success.forEach(msg => { %>
        <p><%= msg %></p>
      <% }) %>
    </div>
  <% } %>

  <% if (messages.error && messages.error.length > 0) { %>
    <div class="flash flash-error" aria-live="polite">
      <% messages.error.forEach(msg => { %>
        <p><%= msg %></p>
      <% }) %>
    </div>
  <% } %>

  <!-- Add new category link (admin-only) -->
  <% if (user && user.role_name === 'admin') { %>
    <p><a href="/new-category" class="btn btn-primary">+ Add New Category</a></p>
  <% } %>

  <!-- Categories list -->
  <section class="card-grid">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(category => { %>
        <div class="card">
          <h2>
            <a href="/category/<%= category.category_id %>">
              <%= category.name %>
            </a>
          </h2>
          <% if (category.description) { %>
            <p><%= category.description %></p>
          <% } %>

          <!-- Edit link (admin-only) -->
          <% if (user && user.role_name === 'admin') { %>
            <p>
              <a href="/edit-category/<%= category.category_id %>" class="btn btn-secondary">✏️ Edit</a>
            </p>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <p>No categories found.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
