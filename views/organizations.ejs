<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>
  <section class="card-grid">
    <% organizations.forEach(org => { %>
      <div class="card">
        <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
        <h2><%= org.name %></h2>
        <p><%= org.description %></p>
        <p><strong>Contact Email:</strong> <a href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a></p>
      </div>
    <% }) %>
  </section>
</main>

<%- include('partials/footer') %>
