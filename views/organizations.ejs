<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <!-- Flash success messages -->
  <% if (typeof messages !== 'undefined' && messages.success && messages.success.length > 0) { %>
    <div class="flash-success">
      <ul>
        <% messages.success.forEach(function(msg) { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Flash error messages -->
  <% if (typeof messages !== 'undefined' && messages.error && messages.error.length > 0) { %>
    <div class="flash-error">
      <ul>
        <% messages.error.forEach(function(msg) { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Validation errors -->
  <% if (errors && errors.length > 0) { %>
    <div class="error-messages">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg ? error.msg : error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Link to create new organization (admin-only) -->
  <% if (user && user.role_name === 'admin') { %>
    <p>
      <a href="/new-organization" class="btn">+ Add New Organization</a>
    </p>
  <% } %>

  <!-- Organizations list -->
  <section class="card-grid">
    <% if (organizations && organizations.length > 0) { %>
      <% organizations.forEach(org => { %>
        <div class="card">
          <!-- Wrap logo + name in a link to the detail page -->
          <a href="/organization/<%= org.organization_id %>" class="org-link">
            <img 
              src="/images/<%= org.logo_filename || 'placeholder-logo.png' %>" 
              alt="<%= org.name ? org.name + ' logo' : 'Organization logo' %>"
              style="max-width:150px;"
            >
            <h2><%= org.name %></h2>
          </a>
          <p><%= org.description %></p>
          <p>
            <strong>Contact Email:</strong> 
            <a href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a>
          </p>

          <!-- Edit link (admin-only) -->
          <% if (user && user.role_name === 'admin') { %>
            <p>
              <a href="/edit-organization/<%= org.organization_id %>" class="btn-small">
                ✏️ Edit
              </a>
            </p>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <p>No organizations found.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
