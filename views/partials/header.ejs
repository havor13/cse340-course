<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %> | Service Network</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header>
    <!-- Service Network Logo -->
    <img src="/images/logo.png" alt="Service Network Logo" class="site-logo">

    <h1>Service Network</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/organizations">Organizations</a>
      <a href="/projects">Projects</a>
      <a href="/categories">Categories</a>
    </nav>
  </header>

  <!-- Flash Messages -->
  <% if (typeof messages !== 'undefined' && Object.keys(messages).length > 0) { %>
    <div class="flash-container">
      <% Object.keys(messages).forEach(type => { %>
        <% messages[type].forEach(msg => { %>
          <p class="flash-<%= type %>"><%= msg %></p>
        <% }) %>
      <% }) %>
    </div>
  <% } %>
