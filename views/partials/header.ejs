<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %> | Service Network</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header>
    <!-- Service Network Logo -->
    <img src="/images/logo.png" alt="Service Network Logo" class="site-logo">

    <h1>Service Network</h1>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/organizations">Organizations</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/categories">Categories</a></li>

        <!-- Admin-only dropdown -->
        <% if (user && user.role_name === 'admin') { %>
          <li class="dropdown">
            <a href="#" class="dropdown-toggle">Admin ▾</a>
            <ul class="dropdown-menu">
              <li><a href="/new-organization">+ Add Organization</a></li>
              <li><a href="/new-project">+ Add Project</a></li>
              <li><a href="/new-category">+ Add Category</a></li>
            </ul>
          </li>
        <% } %>

        <!-- Auth links -->
        <% if (isLoggedIn) { %>
          <li><a href="/dashboard">Dashboard</a></li>
          <li>
            <form action="/logout" method="POST" style="display:inline;">
              <button type="submit" class="btn-link">Logout</button>
            </form>
          </li>
        <% } else { %>
          <li><a href="/register">Register</a></li>
          <li><a href="/login">Login</a></li>
        <% } %>
      </ul>
    </nav>
  </header>

  <!-- Flash Messages -->
  <% if (typeof messages !== 'undefined' && Object.keys(messages).length > 0) { %>
    <div class="flash-container">
      <% Object.keys(messages).forEach(type => { %>
        <% messages[type].forEach(msg => { %>
          <p class="flash-<%= type %>"><%= msg %></p>
        <% }) %>
      <% }) %>
    </div>
  <% } %>
