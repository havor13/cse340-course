<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <!-- Flash messages -->
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <p class="flash-success"><%= messages.success[0] %></p>
  <% } else if (messages && messages.error && messages.error.length > 0) { %>
    <p class="flash-error"><%= messages.error[0] %></p>
  <% } %>

  <!-- Validation errors -->
  <% if (errors && errors.length > 0) { %>
    <div class="error-messages">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Organization form -->
  <form action="/new-organization" method="POST">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        value="<%= oldInput && oldInput.name ? oldInput.name : '' %>" 
        maxlength="150" 
        required
      >
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea 
        id="description" 
        name="description" 
        maxlength="500" 
        required
      ><%= oldInput && oldInput.description ? oldInput.description : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input 
        type="email" 
        id="contactEmail" 
        name="contactEmail" 
        value="<%= oldInput && oldInput.contactEmail ? oldInput.contactEmail : '' %>" 
        maxlength="255" 
        required
      >
    </div>

    <button type="submit">Add Organization</button>
  </form>

  <!-- Navigation -->
  <p><a href="/organizations">← Back to all organizations</a></p>
</main>

<%- include('partials/footer') %>
