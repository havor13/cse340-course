<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <!-- Flash messages -->
  <% if (messages && messages.success) { %>
    <p class="flash-success"><%= messages.success %></p>
  <% } %>
  <% if (messages && messages.error) { %>
    <p class="flash-error"><%= messages.error %></p>
  <% } %>

  <!-- Error messages -->
  <% if (errors && errors.length > 0) { %>
    <div class="error-messages">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Success message -->
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <div class="success-message">
      <%= messages.success[0] %>
    </div>
  <% } %>

  <!-- Organization form -->
  <form action="/new-organization" method="POST">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        value="<%= oldInput && oldInput.name ? oldInput.name : '' %>" 
        maxlength="150" 
        required
      >
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea 
        id="description" 
        name="description" 
        maxlength="500" 
        required
      ><%= oldInput && oldInput.description ? oldInput.description : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input 
        type="email" 
        id="contactEmail" 
        name="contactEmail" 
        value="<%= oldInput && oldInput.contactEmail ? oldInput.contactEmail : '' %>" 
        maxlength="255" 
        required
      >
    </div>

    <!-- ✅ Logo field (optional, placeholder used if blank) -->
    <div class="form-group">
      <label for="logo_filename">Image URL</label>
      <input 
        type="text" 
        id="logo_filename" 
        name="logo_filename" 
        value="<%= oldInput && oldInput.logo_filename ? oldInput.logo_filename : '' %>" 
        placeholder="https://example.com/logo.png"
      >
    </div>

    <button type="submit">Add Organization</button>
  </form>

  <!-- Navigation -->
  <p><a href="/organizations">← Back to all organizations</a></p>
</main>

<%- include('partials/footer') %>
