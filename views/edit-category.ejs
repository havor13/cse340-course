<%- include('partials/header') %>

<main>
  <h1>Edit Category</h1>

  <!-- Flash messages -->
  <% if (messages && messages.success) { %>
    <p class="flash-success"><%= messages.success %></p>
  <% } %>
  <% if (messages && messages.error) { %>
    <p class="flash-error"><%= messages.error %></p>
  <% } %>

  <!-- Edit category form -->
  <form action="/edit-category/<%= category.category_id %>" method="POST">
    <div class="form-group">
      <label for="name">Category Name</label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        value="<%= category.name %>" 
        maxlength="100" 
        required
      >
    </div>

    <div class="form-group">
      <label for="image_url">Image URL</label>
      <input 
        type="text" 
        id="image_url" 
        name="image_url" 
        value="<%= category.image_url || '' %>"
        placeholder="https://example.com/image.jpg"
      >
    </div>

    <% if (category.image_url) { %>
      <div class="image-preview">
        <p>Current Image:</p>
        <img src="<%= category.image_url %>" alt="Category image" style="max-width:200px;">
      </div>
    <% } %>

    <!-- Show server-side validation errors -->
    <% if (errors && errors.length > 0) { %>
      <ul class="error-list">
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <button type="submit">Update Category</button>
  </form>

  <!-- Navigation -->
  <p><a href="/categories">← Back to Categories</a></p>
</main>

<%- include('partials/footer') %>
