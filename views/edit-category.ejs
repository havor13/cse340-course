<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <!-- Flash messages -->
  <% if (messages && messages.success) { %>
    <p class="flash-success"><%= messages.success %></p>
  <% } %>
  <% if (messages && messages.error) { %>
    <div class="flash-error">
      <% if (Array.isArray(messages.error)) { %>
        <ul>
          <% messages.error.forEach(function(msg) { %>
            <li><%= msg %></li>
          <% }) %>
        </ul>
      <% } else { %>
        <p><%= messages.error %></p>
      <% } %>
    </div>
  <% } %>

  <!-- Error messages -->
  <% if (errors && errors.length > 0) { %>
    <div class="error-messages">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg ? error.msg : error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Edit Category form -->
  <form action="/edit-category/<%= category.category_id %>" method="POST">
    <div class="form-group">
      <label for="name">Category Name</label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        value="<%= (typeof oldInput !== 'undefined' && oldInput.name) ? oldInput.name : category.name %>" 
        maxlength="100" 
        required
      >
      <small>Max length: 100 characters</small>
    </div>

    <button type="submit">Update Category</button>
    <a href="/categories" class="btn-cancel">Cancel</a>
  </form>

  <!-- Navigation -->
  <p><a href="/categories">← Back to all categories</a></p>
</main>

<%- include('partials/footer') %>
