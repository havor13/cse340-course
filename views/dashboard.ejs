<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <!-- Personalized welcome -->
  <h2>Welcome, <%= name %> 👋</h2>
  <p>You are logged in as <strong><%= role %></strong>.</p>
  <p>Email: <%= email %></p>

  <!-- Flash Messages -->
  <% if (typeof messages !== 'undefined' && Object.keys(messages).length > 0) { %>
    <div class="flash-container">
      <% Object.keys(messages).forEach(type => { %>
        <% messages[type].forEach(msg => { %>
          <p class="flash-<%= type %>"><%= msg %></p>
        <% }) %>
      <% }) %>
    </div>
  <% } %>

  <!-- Admin-only link to Users page -->
  <% if (user && user.role_name === 'admin') { %>
    <p>
      <a href="/users" class="btn btn-primary">👥 View All Users</a>
    </p>
  <% } %>

  <!-- Volunteer Projects Section -->
  <h2>Your Volunteer Projects</h2>
  <% if (volunteers && volunteers.length > 0) { %>
    <ul>
      <% volunteers.forEach(project => { %>
        <li>
          <strong><%= project.title %></strong> <!-- ✅ use title instead of name -->
          <form action="/projects/<%= project.project_id %>/unvolunteer" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-small danger">Remove</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>You haven’t volunteered for any projects yet.</p>
  <% } %>
</main>

<%- include('partials/footer') %>
