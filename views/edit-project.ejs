<%- include('partials/header') %>

<main>
  <h1>Edit Project</h1>

  <!-- Flash messages -->
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <div class="flash-success"><%= messages.success[0] %></div>
  <% } %>
  <% if (messages && messages.error && messages.error.length > 0) { %>
    <div class="flash-error"><%= messages.error[0] %></div>
  <% } %>

  <form action="/projects/edit-project/<%= project.project_id %>" method="POST">
    <div class="form-group">
      <label for="title">Title</label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        value="<%= old?.title || project.title %>" 
        required 
        maxlength="200" 
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea 
        id="description" 
        name="description" 
        required 
        maxlength="1000"
      ><%= old?.description || project.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input 
        type="text" 
        id="location" 
        name="location" 
        value="<%= old?.location || project.location %>" 
        required 
        maxlength="200" 
      />
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input 
        type="date" 
        id="date" 
        name="date" 
        value="<%= old?.date || project.date %>" 
        required 
      />
    </div>

    <div class="form-group">
      <label for="organizationId">Organization</label>
      <select id="organizationId" name="organizationId" required>
        <% organizations.forEach(org => { %>
          <option 
            value="<%= org.organization_id %>" 
            <%= (old?.organizationId == org.organization_id || org.organization_id === project.organization_id) ? "selected" : "" %>
          >
            <%= org.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <% if (errors && errors.length > 0) { %>
      <ul class="error-list">
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <button type="submit">Update Project</button>
  </form>

  <p><a href="/projects/<%= project.project_id %>">← Back to Project</a></p>
</main>

<%- include('partials/footer') %>
