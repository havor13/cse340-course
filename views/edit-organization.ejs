<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <!-- Flash error messages -->
  <% if (messages && messages.error && messages.error.length > 0) { %>
    <div class="error-messages">
      <ul>
        <% messages.error.forEach(function(msg) { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Flash success message -->
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <div class="success-message">
      <%= messages.success[0] %>
    </div>
  <% } %>

  <form action="/edit-organization/<%= organization.organization_id %>" method="POST">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        value="<%= organization.name %>" 
        maxlength="150" 
        required
      >
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea 
        id="description" 
        name="description" 
        maxlength="500" 
        required
      ><%= organization.description %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input 
        type="email" 
        id="contactEmail" 
        name="contactEmail" 
        value="<%= organization.contact_email %>" 
        maxlength="255" 
        required
      >
    </div>

    <!-- Server-side validation errors (if passed directly as 'errors') -->
    <% if (errors && errors.length > 0) { %>
      <ul class="error-list">
        <% errors.forEach(error => { %>
          <li><%= error.msg ? error.msg : error %></li>
        <% }) %>
      </ul>
    <% } %>

    <button type="submit">Update Organization</button>
  </form>

  <p><a href="/organizations">← Back to all organizations</a></p>
</main>

<%- include('partials/footer') %>
