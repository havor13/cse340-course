<%- include('partials/header') %>

<main>
  <h1>New Project | Service Network</h1>

  <!-- Flash messages -->
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <div class="flash-success"><%= messages.success[0] %></div>
  <% } else if (messages && messages.error && messages.error.length > 0) { %>
    <div class="flash-error"><%= messages.error[0] %></div>
  <% } %>

  <!-- Validation errors -->
  <% if (errors && errors.length > 0) { %>
    <ul class="error-list">
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <!-- Project form -->
  <form action="/projects/new-project" method="POST">
    <div class="form-group">
      <label for="title">Title</label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        value="<%= old?.title || '' %>" 
        required 
        maxlength="200" 
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea 
        id="description" 
        name="description" 
        required 
        maxlength="1000"
      ><%= old?.description || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input 
        type="text" 
        id="location" 
        name="location" 
        value="<%= old?.location || '' %>" 
        required 
        maxlength="200" 
      />
    </div>

    <div class="form-group">
      <label for="project_date">Date</label>
      <input 
        type="date" 
        id="project_date" 
        name="project_date" 
        value="<%= old?.project_date || '' %>" 
        required 
      />
    </div>

    <div class="form-group">
      <label for="organizationId">Organization</label>
      <select id="organizationId" name="organizationId" required>
        <% organizations.forEach(org => { %>
          <option 
            value="<%= org.organization_id %>" 
            <%= old?.organizationId == org.organization_id ? "selected" : "" %>
          >
            <%= org.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <button type="submit">Create Project</button>
  </form>

  <p><a href="/projects">← Back to Projects</a></p>
</main>

<%- include('partials/footer') %>
