<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <!-- Success messages -->
<% if (messages && messages.success && messages.success.length > 0) { %>
  <div class="flash-success">
    <ul>
      <% messages.success.forEach(function(msg) { %>
        <li><%= msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<!-- Error messages -->
<% if (messages && messages.error && messages.error.length > 0) { %>
  <div class="flash-error">
    <ul>
      <% messages.error.forEach(function(msg) { %>
        <li><%= msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>


  <!-- Validation errors -->
  <% if (errors && errors.length > 0) { %>
    <div class="error-messages">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg ? error.msg : error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Organization details -->
  <section class="organization-details">
    <h2><%= organization.name %></h2>
    <p><strong>Description:</strong> <%= organization.description %></p>
    <p><strong>Contact Email:</strong> <%= organization.contact_email %></p>

    <% if (organization.logo_filename) { %>
      <div class="image-preview">
        <p>Logo:</p>
        <img src="<%= organization.logo_filename %>" alt="Organization logo" style="max-width:200px;">
      </div>
    <% } %>
  </section>

  <!-- Projects list -->
  <section class="projects">
    <h3>Projects</h3>
    <% if (projects && projects.length > 0) { %>
      <ul>
        <% projects.forEach(project => { %>
          <li><%= project.name %></li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No projects found for this organization.</p>
    <% } %>
  </section>

  <!-- Navigation -->
  <p>
    <a href="/edit-organization/<%= organization.organization_id %>">✏️ Edit Organization</a> | 
    <a href="/organizations">← Back to all organizations</a>
  </p>
</main>

<%- include('partials/footer') %>
