<%- include('partials/header') %>

<main>
  <% if (category) { %>
    <!-- Category Details -->
    <h1><%= category.name %></h1>
    <p><%= category.description %></p>

    <!-- Navigation Links -->
    <p>
      <a href="/edit-category/<%= category.category_id %>" class="btn-small">
        ✏️ Edit Category
      </a>
      <a href="/categories" class="btn-small">
        ← Back to Categories
      </a>
    </p>

    <!-- Projects in this Category -->
    <h2>Projects in this Category:</h2>
    <section class="card-grid">
      <% if (projects && projects.length > 0) { %>
        <% projects.forEach(project => { %>
          <div class="card">
            <h3>
              <a href="/project/<%= project.project_id %>">
                <%= project.name %>
              </a>
            </h3>
            <p><%= project.description %></p>
            <p>
              <strong>Organization:</strong>
              <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
              </a>
            </p>
          </div>
        <% }) %>
      <% } else { %>
        <p>No projects found for this category.</p>
      <% } %>
    </section>
  <% } else { %>
    <!-- Fallback if category not found -->
    <h1>Category not found</h1>
    <p>Please check the link or return to the categories list.</p>
  <% } %>
</main>

<%- include('partials/footer') %>
