<%- include('partials/header') %>

<main>
  <h1><%= category.name %></h1>

  <!-- Flash messages -->
  <% if (messages.success && messages.success.length > 0) { %>
    <div class="flash flash-success" aria-live="polite">
      <% messages.success.forEach(msg => { %>
        <p><%= msg %></p>
      <% }) %>
    </div>
  <% } %>

  <% if (messages.error && messages.error.length > 0) { %>
    <div class="flash flash-error" aria-live="polite">
      <% messages.error.forEach(msg => { %>
        <p><%= msg %></p>
      <% }) %>
    </div>
  <% } %>

  <!-- Category description -->
  <% if (category.description) { %>
    <p><%= category.description %></p>
  <% } %>

  <!-- Related projects -->
  <section>
    <h2>Projects in this Category</h2>
    <% if (projects && projects.length > 0) { %>
      <ul class="project-list">
        <% projects.forEach(project => { %>
          <li>
            <a href="/project/<%= project.project_id %>"><%= project.name %></a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No projects assigned to this category yet.</p>
    <% } %>
  </section>

  <!-- Actions -->
  <p>
    <% if (user && user.role_name === 'admin') { %>
      <a href="/edit-category/<%= category.category_id %>" class="btn btn-secondary">✏️ Edit Category</a>
      |
    <% } %>
    <a href="/categories" class="btn btn-link">← Back to Categories</a>
  </p>
</main>

<%- include('partials/footer') %>
