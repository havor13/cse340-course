<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <!-- Flash messages -->
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <p class="flash-success"><%= messages.success[0] %></p>
  <% } else if (messages && messages.error && messages.error.length > 0) { %>
    <p class="flash-error"><%= messages.error[0] %></p>
  <% } %>

  <!-- Add Project button -->
  <p>
    <a href="/projects/new-project" class="btn-small">+ Add a New Service Project</a>
  </p>

  <section class="card-grid">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach(project => { %>
        <div class="card">
          <!-- Project title links to detail page -->
          <h2>
            <a href="/projects/<%= project.project_id %>">
              <%= project.title %>
            </a>
          </h2>

          <p><%= project.description %></p>

          <p><strong>Location:</strong> <%= project.location %></p>
          <p><strong>Date:</strong> 
            <% if (project.project_date instanceof Date) { %>
              <%= project.project_date.toDateString() %>
            <% } else { %>
              <%= project.project_date %>
            <% } %>
          </p>

          <p>
            <strong>Organization:</strong>
            <a href="/organizations/<%= project.organization_id %>">
              <%= project.organization_name %>
            </a>
          </p>

          <!-- Categories -->
          <% if (project.categories && project.categories.length > 0) { %>
            <p>
              <strong>Categories:</strong>
              <% project.categories.forEach(cat => { %>
                <a href="/categories/<%= cat.category_id %>" class="tag">
                  <%= cat.name %>
                </a>
              <% }) %>
            </p>
          <% } %>

          <!-- Action buttons -->
          <p>
            <a href="/projects/edit-project/<%= project.project_id %>" class="btn-small">✏️ Edit</a>
            <a href="/projects/<%= project.project_id %>/assign-categories" class="btn-small">Assign Categories</a>
          </p>

          <form action="/projects/delete-project/<%= project.project_id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn-small danger">🗑 Delete</button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <p>No projects found.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
