<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <!-- Flash messages -->
  <% if (messages && messages.success) { %>
    <p class="flash-success"><%= messages.success %></p>
  <% } %>
  <% if (messages && messages.error) { %>
    <div class="flash-error">
      <% if (Array.isArray(messages.error)) { %>
        <ul>
          <% messages.error.forEach(function(msg) { %>
            <li><%= msg %></li>
          <% }) %>
        </ul>
      <% } else { %>
        <p><%= messages.error %></p>
      <% } %>
    </div>
  <% } %>

  <!-- Add Project button -->
  <p>
    <a href="/new-project" class="btn-small">+ Add a New Service Project</a>
  </p>

  <section class="card-grid">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach(project => { %>
        <div class="card">
          <!-- Project title links to detail page -->
          <h2>
            <a href="/projects/<%= project.project_id %>">
              <%= project.title %>
            </a>
          </h2>
          <p><%= project.description %></p>

          <p><strong>Location:</strong> <%= project.location %></p>
          <p><strong>Date:</strong> 
            <% if (project.project_date instanceof Date) { %>
              <%= project.project_date.toDateString() %>
            <% } else { %>
              <%= project.project_date %>
            <% } %>
          </p>

          <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
              <%= project.organization_name %>
            </a>
          </p>

          <!-- Optional: show category tags -->
          <% if (project.categories && project.categories.length > 0) { %>
            <p>
              Categories:
              <% project.categories.forEach(cat => { %>
                <a href="/category/<%= cat.category_id %>" class="tag">
                  <%= cat.name %>
                </a>
              <% }) %>
            </p>
          <% } %>

          <!-- Edit and Assign Categories buttons -->
          <p>
            <a href="/edit-project/<%= project.project_id %>" class="btn-small">✏️ Edit</a>
            <a href="/projects/<%= project.project_id %>/assign-categories" class="btn-small">Assign Categories</a>
          </p>

          <!-- Delete button -->
          <form action="/delete-project/<%= project.project_id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn-small danger">🗑 Delete</button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <p>No projects found.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
